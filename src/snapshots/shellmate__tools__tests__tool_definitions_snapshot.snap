---
source: src/tools.rs
expression: tool_definitions()
---
[
  {
    "function": {
      "description": "Read and return the contents of a file",
      "name": "Read",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Read and return the contents of a file",
        "properties": {
          "file_path": {
            "description": "The path to the file to read",
            "type": "string"
          }
        },
        "required": [
          "file_path"
        ],
        "title": "ReadInput",
        "type": "object"
      }
    },
    "type": "function"
  },
  {
    "function": {
      "description": "Write content to a file",
      "name": "Write",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Write content to a file",
        "properties": {
          "content": {
            "description": "The content to write to the file",
            "type": "string"
          },
          "file_path": {
            "description": "The path of the file to write to",
            "type": "string"
          }
        },
        "required": [
          "file_path",
          "content"
        ],
        "title": "WriteInput",
        "type": "object"
      }
    },
    "type": "function"
  },
  {
    "function": {
      "description": "Execute a shell command",
      "name": "Bash",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Execute a shell command",
        "properties": {
          "command": {
            "description": "The command to execute",
            "type": "string"
          }
        },
        "required": [
          "command"
        ],
        "title": "BashInput",
        "type": "object"
      }
    },
    "type": "function"
  },
  {
    "function": {
      "description": "Execute a Skill",
      "name": "Skill",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Execute a Skill",
        "properties": {
          "arguments": {
            "description": "The optional arguments want to pass to the skill",
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "description": "The name of the skill want to execute",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "SkillInput",
        "type": "object"
      }
    },
    "type": "function"
  }
]
